#!/bin/bash
# Git pre-push hook for Atomica
# Blocks pushes that don't pass build, lint, and format checks

# --------------------------------------------------
# 0. Documentation Rules Check
# --------------------------------------------------
echo "📜 Checking documentation rules..."
if [ -f "scripts/check-docs.js" ]; then
    # Using bun to run the node script since bun is available
    bun scripts/check-docs.js
    if [ $? -ne 0 ]; then
        echo "❌ Documentation checks failed."
        exit 1
    fi
else
    echo "⚠️ scripts/check-docs.js not found. Skipping documentation check."
fi

# AGENT WARNING: You CANNOT push until code quality checks pass.
# Do not try to override this hook or bypass it.

set -e  # Exit on any error - block the push

REPO_ROOT=$(git rev-parse --show-toplevel)

# Function to run checks on a module if it has node_modules
check_module() {
    local name=$1
    local path=$2
    local build_cmd=${3:-"bun run build"}
    local lint_cmd=${4:-"bun run lint -- --max-warnings=0"}
    local format_cmd=${5:-"bun run format:check"}

    echo "--------------------------------------------------"
    echo "🔍 Checking module: $name"
    
    echo "📍 Path: $path"
    cd "$REPO_ROOT/$path"

    if [ ! -d "node_modules" ]; then
        echo "📦 node_modules not found. Running 'bun install'..."
        bun install
    fi
    
    echo "📦 Building..."
    $build_cmd
    
    echo "✨ Linting..."
    $lint_cmd
    
    echo "📐 Checking Format..."
    $format_cmd
    
    echo "✅ $name passed all checks."
}

echo "🚀 Running pre-push code quality checks..."

# 1. State Proof Verifier (Primary focus)
check_module "State Proof Verifier" "source/state-proofs/typescript"

# 2. Ethereum Docker Testnet SDK
check_module "Ethereum Docker SDK" "source/docker-testnet/ethereum-testnet/typescript-sdk" "bun run build" "echo '✨ Skipping lint: not configured'" "echo '📐 Skipping format: not configured'"

# 3. EVM Contracts Test Orchestrator
check_module "EVM Contracts Test Orchestrator" "source/evm-contracts/test-orchestration" "bun run build" "bun run lint" "bun run format:check"

# 4. Aptos Docker Testnet SDK (Optional/Skip if no node_modules)
check_module "Aptos Docker Testnet SDK" "source/docker-testnet/aptos-testnet"

# 5. Atomica SDK
check_module "Atomica SDK" "source/atomica-sdk"

# 6. Atomica Web Components
check_module "Atomica Web Components" "source/atomica-web-components" "bun run build" "bun run lint" "bun run format:check"

# 7. Atomica Demo
check_module "Atomica Demo" "source/atomica-demo" "bun run build" "bun run lint" "bun run format:check"

# --------------------------------------------------
# 8. SDK Dependency Boundary Check
# --------------------------------------------------
echo "--------------------------------------------------"
echo "🔒 Checking SDK dependency boundaries..."

SDK_SRC="$REPO_ROOT/source/atomica-sdk/src"

# Fail if any SDK source file imports react or react-dom
if grep -r --include="*.ts" --include="*.tsx" \
    "from ['\"]react['\"]\\|from ['\"]react-dom['\"]\\|from ['\"]react/" \
    "$SDK_SRC" 2>/dev/null | grep -v "//"; then
    echo "❌ SDK boundary violation: atomica-sdk/src must not import react or react-dom."
    echo "   Move React-dependent code to atomica-web-components."
    exit 1
fi

# Fail if any SDK source file imports @atomica/atomica-web-components
if grep -r --include="*.ts" --include="*.tsx" \
    "@atomica/atomica-web-components" \
    "$SDK_SRC" 2>/dev/null; then
    echo "❌ SDK boundary violation: atomica-sdk/src must not import @atomica/atomica-web-components."
    echo "   The dependency direction must be: atomica-web-components -> atomica-sdk (not the reverse)."
    exit 1
fi

echo "✅ SDK dependency boundaries clean."

echo "--------------------------------------------------"
echo "🎉 Code quality checks passed! Push allowed."
echo ""
echo "Note: Tests are not enforced by this hook. CI will catch test failures."
exit 0
