# Atomica shared environment variables
#
# Copy this file to `.env.local` (ignored) and fill in real values before running the suites.
# The keys below allow the test suites, scripts, and `atomica-web` to share the same account material
# while staying rooted at the workspace.

## Core Resources (Aptos faucet account)
# Download the private key from `source/docker-testnet/config/genesis-artifacts/root-account-private-keys.yaml`.
# The account address is always `0x00000000000000000000000000000000000000000000000000000000A550C18`.
CORE_RESOURCES_ADDRESS=0x00000000000000000000000000000000000000000000000000000000A550C18
CORE_RESOURCES_PRIVATE_KEY=0x51bcebc3db26b1af5778ed86e9126c25759263adeb4fa149a0aea07425ec5caa

## Aptos deployer
# Any validator private key under `source/docker-testnet/config/validators/validator-*/private-keys.yaml` works.
APTOS_DEPLOYER_ADDRESS=0x44eb548f999d11ff192192a7e689837e3d7a77626720ff86725825216fcbd8aa
APTOS_DEPLOYER_PRIVATE_KEY=0x52a0d787625121df4e45d1d6a36f71dce7466710404f22ae3f21156828551717

## Ethereum deployer
# Use the testnet mnemonic or one of its derived accounts (`source/docker-testnet/ethereum-testnet/typescript-sdk/src/index.ts`).
ETH_DEPLOYER_ADDRESS=0x8943545177806ED17B9F23F0a21ee5948eCaa776
ETH_DEPLOYER_PRIVATE_KEY=0xbcdf20249abf0ed6d944c0288fad489e33f66b3960d9e6229c1cd214ed3bbe31
ETH_DEPLOYER_MNEMONIC=giant issue aisle success illegal bike spike question tent bar rely arctic volcano long crawl hungry vocal artwork sniff fantasy very lucky have athlete

## Hardhat account 0 (used by wallet tests)
HARDHAT_ACCOUNT_0_ADDRESS=0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266
HARDHAT_ACCOUNT_0_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

## Optional overrides
# You can override the RPC endpoint when deploying or running tests.
#ETH_RPC_URL=http://localhost:8545
