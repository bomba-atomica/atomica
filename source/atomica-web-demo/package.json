{
  "name": "@atomica/atomica-web-demo",
  "version": "0.1.0",
  "description": "Atomica Auction Demo Application",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run prepare:deps && tsc -b && vite build",
    "test": "bun run prepare:deps && vitest run",
    "test:ui": "bun run prepare:deps && vitest run tests/ui-component",
    "prepare:deps": "cd ../docker-testnet/ethereum-testnet/typescript-sdk && bun install && bun run build && cd ../../aptos-testnet && bun install && bun run build && cd ../../state-proofs/typescript && bun install && bun run build && cd ../../atomica-web-ui && bun install && bun run build",
    "demo": "bun run prepare:deps && bun scripts/orchestrator.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@atomica/atomica-web-ui": "file:../atomica-web-ui",
    "@atomica/aptos-docker-testnet": "file:../docker-testnet/aptos-testnet",
    "@atomica/state-proof-verifier": "file:../state-proofs/typescript",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/postcss": "^4.1.18",
    "ethers": "^6.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser": "^4.0.16",
    "@vitest/browser-playwright": "^4.0.16",
    "@vitest/browser-preview": "^4.0.16",
    "happy-dom": "^20.0.11",
    "playwright": "^1.57.0",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vitest": "^4.0.15",
    "vitest-browser-react": "^2.0.2"
  }
}
