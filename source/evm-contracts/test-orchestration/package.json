{
  "name": "@atomica/evm-contracts-test-orchestrator",
  "version": "1.0.0",
  "description": "Test orchestration for Atomica EVM contracts using Docker testnet",
  "type": "module",
  "scripts": {
    "build": "echo 'No build step required for TypeScript scripts'",
    "postinstall": "cd ../../docker-testnet/ethereum-testnet/typescript-sdk && bun install && bun run build",
    "start": "bun run src/index.ts",
    "test": "bun run src/index.ts --test all",
    "test:unit": "bun run src/index.ts --test unit",
    "test:integration": "bun run src/index.ts --test integration",
    "test:e2e": "bun run src/index.ts --test e2e",
    "test:smoke": "bun run src/index.ts --test smoke",
    "deploy": "bun run src/deploy.ts",
    "clean": "bun run src/clean.ts",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "format": "prettier 'src/**/*.ts' --write",
    "format:check": "prettier 'src/**/*.ts' --check"
  },
  "dependencies": {
    "@atomica/ethereum-docker-testnet": "file:../../docker-testnet/ethereum-testnet/typescript-sdk",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.8.2",
    "bun-types": "^1.1.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.0.0"
  }
}