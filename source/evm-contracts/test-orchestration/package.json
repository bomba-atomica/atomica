{
  "name": "@atomica/evm-contracts-test-orchestrator",
  "version": "1.0.0",
  "description: "Test orchestration for Atomica EVM contracts using Docker testnet",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun run src/index.ts --test all",
    "test:unit": "bun run src/index.ts --test unit",
    "test:integration": "bun run src/index.ts --test integration",
    "test:e2e": "bun run src/index.ts --test e2e",
    "test:smoke": "bun run src/index.ts --test smoke",
    "deploy": "bun run src/deploy.ts",
    "clean": "bun run src/clean.ts"
  },
  "dependencies": {
    "@atomica/ethereum-docker-testnet": "workspace:*",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "bun-types": "^1.1.0"
  }
}
