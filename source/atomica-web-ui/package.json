{
  "name": "@atomica/atomica-web-ui",
  "version": "0.1.0",
  "description": "Reusable UI components for Atomica web applications",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/**/*.ts src/**/*.tsx",
    "lint:fix": "eslint src/**/*.ts src/**/*.tsx --fix",
    "format": "prettier --write 'src/**/*.ts' 'src/**/*.tsx'",
    "format:check": "prettier --check 'src/**/*.ts' 'src/**/*.tsx'"
  },
  "dependencies": {
    "@atomica/aptos-docker-testnet": "file:../docker-testnet/aptos-testnet",
    "@atomica/state-proof-verifier": "file:../state-proofs/typescript",
    "@heroicons/react": "^2.2.0",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "~5.9.3"
  }
}
