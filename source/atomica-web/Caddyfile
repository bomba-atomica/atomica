# Atomica — local SSL termination via Caddy
#
# Caddy provides HTTPS on :5174 and forwards everything to the Vite dev
# server on :5173. Vite's own proxy config handles /aptos-api and /eth-api
# routing — no duplication here.
#
# Quick start:
#   1. Install Caddy:          brew install caddy
#   2. Trust the local CA once: cd source/atomica-web && bun run caddy:trust
#   3. Start Vite:              bun run dev          (listens on :5173)
#   4. Start Caddy:             bun run caddy        (HTTPS on :5174)
#
# Then open https://localhost:5174

{
	local_certs
}

https://localhost:5174 {
	reverse_proxy localhost:5173 {
		# Forward Upgrade header so Vite's HMR websocket works over HTTPS.
		header_up Connection {http.request.header.Connection}
		header_up Upgrade   {http.request.header.Upgrade}
	}
}
