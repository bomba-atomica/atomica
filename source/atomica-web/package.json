{
  "name": "atomica-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:ui": "vitest run tests/ui-component",
    "test:meta": "vitest run --config vitest.config.nodejs.ts",
    "test:docker": "bun run prepare:aptos && vitest run --config vitest.config.nodejs.ts tests/meta/docker-testnet.test.ts",
    "test:dual": "bun run prepare:all && vitest run --config vitest.config.nodejs.ts tests/meta/dual-testnet",
    "test:proofs": "vitest run tests/unit/ethereum/storage-key.test.ts",
    "testnet": "bun run prepare:all && bun scripts/testnet-only.ts",
    "demo": "bun run prepare:all && bun scripts/dual-testnet-orchestrator.ts",
    "demo:aptos-only": "bun run prepare:aptos && bun scripts/orchestrator.ts",
    "demo:ethereum-only": "bun run prepare:ethereum && bun scripts/ethereum-testnet-only.ts",
    "proof:generate": "bun run scripts/generate-proof.ts",
    "prepare:all": "bun run prepare:ethereum && bun run prepare:aptos",
    "prepare:ethereum": "cd ../docker-testnet/ethereum-testnet/typescript-sdk && bun install && bun run build",
    "prepare:aptos": "cd ../docker-testnet/typescript-sdk && bun install && bun run build",
    "prepare:testnet": "bun run prepare:aptos",
    "postinstall": "bun run prepare:all"
  },
  "dependencies": {
    "@aptos-labs/ts-sdk": "^6.0.0",
    "@atomica/docker-testnet": "file:../docker-testnet/typescript-sdk",
    "@atomica/ethereum-docker-testnet": "file:../docker-testnet/ethereum-testnet/typescript-sdk",
    "@atomica/state-proof-verifier": "file:../state-proofs/typescript",
    "@heroicons/react": "^2.2.0",
    "@noble/bls12-381": "^1.4.0",
    "@tailwindcss/postcss": "^4.1.18",
    "aptos": "^1.22.1",
    "autoprefixer": "^10.4.22",
    "ethers": "^6.16.0",
    "got": "11.8.6",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.4",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/browser": "^4.0.16",
    "@vitest/browser-playwright": "^4.0.16",
    "@vitest/browser-preview": "^4.0.16",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eth-testing": "^1.14.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.0.11",
    "node-fetch": "^3.3.2",
    "playwright": "^1.57.0",
    "prettier": "^3.7.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.1",
    "vitest": "^4.0.15",
    "vitest-browser-react": "^2.0.2"
  }
}
